# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-event-app

# Consumer Configuration
CONSUMER_GROUP_ID=event-consumer-group
CONSUMER_SESSION_TIMEOUT=30000
CONSUMER_HEARTBEAT_INTERVAL=3000

# Producer Configuration
PRODUCER_RETRY_ATTEMPTS=5
PRODUCER_RETRY_DELAY=300

# Topics
TOPIC_ORDERS=orders
TOPIC_USERS=users
TOPIC_NOTIFICATIONS=notifications
TOPIC_PAYMENTS=payments

# Application Configuration
LOG_LEVEL=info
NODE_ENV=development
